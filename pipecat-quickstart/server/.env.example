# ==========================================
# AI-Recruiter Voice Agent — Environment
# Copy to .env and fill in. (cp .env.example .env)
# ==========================================

# --- LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech-to-Text (Deepgram) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Text-to-Speech (Cartesia) ---
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# --- Transport (LiveKit) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_ROOM_NAME is derived per-interview going forward; kept for legacy/dev.
LIVEKIT_ROOM_NAME=test-room

# --- Database (PostgreSQL; shared with the main API) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_user
DB_PASSWORD=secure_password
DB_NAME=ai_recruiter
# Or a single URL (asyncpg): DATABASE_URL=postgresql://ai_user:secure_password@localhost:5432/ai_recruiter

# First-time bootstrap only (scripts/bootstrap_db.py). A privileged role allowed to
# CREATE ROLE + CREATE DATABASE. Used ONLY by the bootstrap script; the app and
# migrations always connect as DB_USER above. Leave password blank for peer auth.
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=
# DB_SUPERUSER_DB=postgres   # maintenance DB to connect to while creating DB_NAME

# --- Pipeline / features ---
PIPELINE_MODE=dual          # single | dual
GOAL_TRACKING_ENABLED=true

# --- Interview links (must MATCH the main API's value) ---
# Used to verify the signed, time-limited interview-invite tokens.
INTERVIEW_LINK_SECRET=change-me-to-a-32+-byte-random-secret
# Base URL of the candidate-facing web app (target of the emailed link).
WEB_BASE_URL=http://localhost:3000

# --- Operator auth & CORS (must MATCH the main API's values) ---
# Bearer token required by operator endpoints (/interview/configure, /chat,
# /settings, /pipeline). Candidate routes (/interview/validate, /events) stay open.
ADMIN_API_TOKEN=change-me-to-a-long-random-secret
# Comma-separated allowed CORS origins (frontend). Defaults to localhost:3000.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared dir where interview audio recordings (WAV) are written by the voice
# agent and read by the backend for HR playback. Must be the same path for both.
RECORDINGS_DIR=/mnt/muaaz/AI_recruiter/data/recordings
