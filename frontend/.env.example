# Frontend environment template. Copy to .env.local and fill in.

# Public (exposed to the browser). Voice service origin for the interview page.
NEXT_PUBLIC_VOICE_URL=http://127.0.0.1:7860

# Server-only (NOT exposed to the browser).
# BACKEND_URL  — FastAPI backend origin the admin proxy forwards to.
# ADMIN_API_TOKEN — shared admin secret; MUST equal the backend's ADMIN_API_TOKEN.
BACKEND_URL=http://127.0.0.1:8000
ADMIN_API_TOKEN=change-me-to-a-long-random-secret
