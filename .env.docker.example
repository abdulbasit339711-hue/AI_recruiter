# ============================================================================
# AI-Recruiter — Docker Compose environment
# Copy to .env (cp .env.docker.example .env) and fill in. Compose reads this file
# for ${VAR} substitution in docker-compose.yml. Service hostnames are hardcoded
# in the compose file — you only provide secrets and a few shared values here.
# ============================================================================

# --- Shared secrets (MUST match across backend + voice) ---------------------
ADMIN_API_TOKEN=change-me-to-a-long-random-secret
INTERVIEW_LINK_SECRET=change-me-to-a-32+-byte-random-secret

# --- Database (shared Postgres; the compose `postgres` service uses these) --
DB_USER=ai_user
DB_PASSWORD=secure_password
DB_NAME=ai_recruiter

# --- LLM / scoring (Groq) ---------------------------------------------------
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Voice pipeline providers ----------------------------------------------
OPENAI_API_KEY=your_openai_key            # optional (LLM, if used)
DEEPGRAM_API_KEY=your_deepgram_api_key    # STT
CARTESIA_API_KEY=your_cartesia_api_key    # TTS
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# --- Transport (LiveKit cloud) ---------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- URLs (host-reachable; defaults assume local docker compose) -----------
NEXT_PUBLIC_VOICE_URL=http://localhost:7860   # browser -> voice service (build-time inlined)
WEB_BASE_URL=http://localhost:3000            # candidate-facing app base (in emailed links)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Voice features ---------------------------------------------------------
PIPELINE_MODE=dual
GOAL_TRACKING_ENABLED=true

# --- Email (optional; SMTP for interview invites) --------------------------
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
