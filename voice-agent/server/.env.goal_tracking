# Goal Tracking Configuration Sample
# Copy this to your .env file and adjust the values

# ===================================
# DATABASE CONFIGURATION
# ===================================

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ai_recruiter

# Database connection pool settings
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# ===================================
# GOAL TRACKING SETTINGS
# ===================================

# Enable/disable goal tracking (true/false)
GOAL_TRACKING_ENABLED=true

# Enable real-time goal analysis (true/false)
REAL_TIME_ANALYSIS=true

# Enable adaptive questioning based on goals (true/false)
ADAPTIVE_QUESTIONING=true

# ===================================
# GROQ API CONFIGURATION
# ===================================

# Your Groq API key (required for goal tracking)
GROQ_API_KEY=your_groq_api_key_here

# Primary model for comprehensive analysis
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile

# Fast model for real-time analysis
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ===================================
# EXISTING CONFIGURATION
# (Keep your existing settings)
# ===================================

# LiveKit settings
LIVEKIT_URL=your_livekit_url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_NAME=test-room

# Speech services
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# Pipeline configuration
PIPELINE_MODE=dual